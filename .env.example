APP_NAME="Aktif Laundry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Makassar

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# KONFIGURASI QRIS
# ==============================================================================
# QRIS Static code untuk convert ke dinamis dengan nominal

QRIS_STATIC="YOUR_STATIC_QRIS_CODE_HERE"

# QR Code retention period in hours (default: 72 hours = 3 days)
# QR codes akan otomatis dihapus setelah waktu ini
# Set ke 0 untuk disable auto-cleanup
# Set ke angka positif untuk auto-cleanup (misal: 24, 48, 72)
QRIS_RETENTION_HOURS=72

# ==============================================================================
# KONFIGURASI GOOGLE OAUTH
# ==============================================================================
# Google OAuth credentials untuk Social Login
# Fitur:
# - Auto-register customer baru jika login pertama kali dengan Google
# - Update data OAuth untuk customer yang sudah ada
# - Menyimpan access token dan refresh token untuk akses Google API
#
# Cara mendapatkan credentials:
# 1. Buka Google Cloud Console: https://console.cloud.google.com/
# 2. Buat project baru atau pilih project yang ada
# 3. Enable Google+ API atau People API
# 4. Buat OAuth 2.0 credentials (Web Application)
# 5. Tambahkan Authorized JavaScript origins:
#    - Development local: https://your-project.test
#    - Development dengan Expose: https://your-subdomain.sharedwithexpose.com
#    - Production: https://yourdomain.com
# 6. Tambahkan Authorized redirect URIs:
#    - Development local: https://your-project.test/pelanggan/auth/google/callback
#    - Development dengan Expose: https://your-subdomain.sharedwithexpose.com/pelanggan/auth/google/callback
#    - Production: https://yourdomain.com/pelanggan/auth/google/callback
# 7. Copy Client ID dan Client Secret ke sini
#
# Note: GOOGLE_REDIRECT_URI harus match dengan salah satu Authorized redirect URIs di Google Console

GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ==============================================================================
# KONFIGURASI FONNTE WHATSAPP API
# ==============================================================================
# Fonnte API Token untuk WhatsApp integration
# Fitur:
# - Kirim pesan WhatsApp otomatis ke pelanggan
# - Kirim notifikasi transaksi dan promo
# - Integrasi dengan device WhatsApp untuk multiple numbers
# - Kirim pesan dengan format media (image, document, dll)
#
# Cara mendapatkan token:
# 1. Daftar akun di: https://fonnte.com/
# 2. Login ke dashboard Fonnte
# 3. Buka menu API Integration atau Settings
# 4. Copy API token yang tersedia
# 5. Paste token di bawah ini
#
# Note: Token ini digunakan untuk authentication dengan API Fonnte
# Pastikan token disimpan dengan aman dan tidak dibagikan secara publik

FONNTE_TOKEN=your-fonnte-api-token-here

NATIVEPHP_APP_ID=com.aktiflaundry.aktiflaundry
NATIVEPHP_APP_VERSION="DEBUG"
NATIVEPHP_APP_VERSION_CODE="1"
